# Firebase Web SDK Configuration Example
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=my-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://my-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=my-project
VITE_FIREBASE_STORAGE_BUCKET=my-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Database Paths
VITE_RTDB_TRIGGER_PATH=object_detected
VITE_FIRESTORE_COLLECTION=bottle_detections

# Google Gemini Vision Live Feed Configuration
VITE_GEMINI_API_KEY=AIzaSy...
VITE_GEMINI_MODEL=gemini-1.5-flash
